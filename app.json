{
  "expo": {
    "name": "PetMatch",
    "slug": "petmatch",
    "description": "Petler tanıştırır; oyun arkadaşlığından dostluğa veya romantik bir bağa uzanan güvenli, pet-first topluluk.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petmatch",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petmatch.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Sahip + pet doğrulama fotoğrafını çekebilmek için kamera izni gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Pet ve sahip fotoğraflarını profiline eklemek için galeri izni gerekiyor.",
        "NSLocationWhenInUseUsageDescription": "Yakınındaki uyumlu petleri ve insanları gösterebilmek için konum izni gerekiyor."
      }
    },
    "android": {
      "package": "com.petmatch.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F97362"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr"
            ],
            "android": [
              "tr"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pet ve sahip fotoğraflarını profiline eklemek için galeri izni gerekiyor.",
          "cameraPermission": "Sahip + pet doğrulama fotoğrafını çekebilmek için kamera izni gerekiyor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki uyumlu petleri ve insanları gösterebilmek için konum izni gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F97362",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F97362",
          "defaultChannel": "petmatch"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "locales": {
      "tr": "./locales/tr.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6007ab9-3dc2-496a-9963-8f4921681047"
      }
    },
    "owner": "karakif"
  }
}
