    "android": {
      "package": "com.petmatch.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#F97362"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr"
            ],
            "android": [
              "tr"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pet ve sahip fotoğraflarını profiline eklemek için galeri izni gerekiyor.",
          "cameraPermission": "Pet ve sahip fotoğraflarını çekmek ve sahip + pet doğrulama fotoğrafını göndermek için kamera izni gerekiyor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki uyumlu petleri ve insanları gösterebilmek için konum izni gerekiyor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F97362",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F97362",
          "defaultChannel": "petmatch",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Onaylanmış buluşmaları takvimine ekleyebilmek için takvim izni gerekiyor.",
          "remindersPermission": "PetMatch hatırlatıcılarını okumaz veya değiştirmez; sistem bu izni takvim erişimiyle birlikte soruyor."
        }
      ]
    ],
    "locales": {
      "tr": "./locales/tr.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6007ab9-3dc2-496a-9963-8f4921681047"
      }
    },
    "owner": "karakif"
  }
