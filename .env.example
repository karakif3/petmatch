# `.env` olarak kopyala ve doldur. `.env` git'e girmez.
#
# Taşınabilirlik: kodun hiçbir yerinde Supabase proje ref'i yok. Başka bir
# hesaba taşımak = yeni projede migration'ları çalıştırıp bu üç satırı değiştirmek.

# ---------------------------------------------------------------------------
# Supabase — EXPO_PUBLIC_* değerleri client bundle'ına gömülür, gizli değildir.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# `npm run gen:types` bunu kullanır (URL'deki <ref>.supabase.co kısmı).
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Aşağıdakiler MVP'de gerekli DEĞİL — sırası gelince doldurulur.
# ---------------------------------------------------------------------------

# Google Sign-In — Supabase Auth Google provider ile eşleşmeli
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple Sign-In (yalnızca App Store yayınına giderken gerekir)
# EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false

# Ürün analitiği
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Yasal yayın bilgileri ve harici linkler
# EXPO_PUBLIC_LEGAL_CONTROLLER_NAME=
# EXPO_PUBLIC_LEGAL_CONTROLLER_ADDRESS=
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Sunucu tarafı — ASLA EXPO_PUBLIC_ ön eki alma, asla commit etme.
# `supabase secrets set` ile ayarlanır.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_PUSH_ACCESS_TOKEN=
