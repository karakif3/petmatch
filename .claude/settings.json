{
  "permissions": {
    "allow": [
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push --set-upstream origin HEAD)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --set-upstream origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin refs/heads/main*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/otonom-guard.sh"
          }
        ]
      }
    ]
  }
}
